# Directed cache test: hit, miss, dirty eviction, writeback, refill —
# against the default hierarchy (32 KiB 8-way L1D, 64-byte lines, so 64
# sets and a 4096-byte stride between addresses that share a set).
#
# The loop stores 42,43,...,50 to nine addresses 0x1000, 0x2000, ...,
# 0x9000. All nine map to L1D set 0; the set holds 8 ways, so the ninth
# store evicts the least-recently-used line (0x1000, dirty) and writes
# it back to L2. Loading 0x1000 afterwards misses and refills the line
# from L2 — printing 42 proves the dirty data survived the round trip.
# Loading 0x9000 hits (still resident) and prints 50.
# Expected output: 42 then 50, exit 0.
000010B7   # lui  x1, 0x1         x1 = 0x1000, walking store pointer
000012B7   # lui  x5, 0x1         x5 = 0x1000, the stride (4096)
02A00113   # addi x2, x0, 42      value to store
00900193   # addi x3, x0, 9       nine lines into an 8-way set
0020A023   # loop: sw x2, 0(x1)
005080B3   # add  x1, x1, x5
00110113   # addi x2, x2, 1
FFF18193   # addi x3, x3, -1
FE0198E3   # bne  x3, x0, loop    (-16)
00001237   # lui  x4, 0x1         x4 = 0x1000
00022303   # lw   x6, 0(x4)       miss; refill the written-back line
00030513   # addi x10, x6, 0
00100893   # addi x17, x0, 1      syscall 1: print integer
00000073   # ecall                prints 42
00009237   # lui  x4, 0x9         x4 = 0x9000
00022303   # lw   x6, 0(x4)       hit; still resident
00030513   # addi x10, x6, 0
00000073   # ecall                prints 50
00000513   # addi x10, x0, 0      exit code 0
05D00893   # addi x17, x0, 93     syscall 93: exit
00000073   # ecall
