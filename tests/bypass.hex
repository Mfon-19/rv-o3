# Directed memory test: a load bypasses an older, unrelated store.
# The store to 512 has its ADDRESS immediately (split store-address/
# store-data) but its DATA hangs on a divide. The younger load from
# 1024 provably doesn't overlap, so it needn't wait for the divide;
# with stores requiring both operands at issue (the old design) the
# store would never have resolved its address and the load would have
# stalled behind the unknown for the divide's full latency.
# Expected output: 3, exit 0.
20000093   # addi x1, x0, 512     store address
40000113   # addi x2, x0, 1024    load address
00300493   # addi x9, x0, 3
03C00413   # addi x8, x0, 60
00912023   # sw   x9, 0(x2)       park 3 at 1024
029451B3   # divu x3, x8, x9      20, slowly; the store data
0030A023   # sw   x3, 0(x1)       address known now, data pending
00012203   # lw   x4, 0(x2)       no overlap with 512: proceeds, gets 3
00020513   # addi x10, x4, 0
00100893   # addi x17, x0, 1      syscall 1: print integer
00000073   # ecall                prints 3
00000513   # addi x10, x0, 0
05D00893   # addi x17, x0, 93     syscall 93: exit
00000073   # ecall
