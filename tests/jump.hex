# Directed control-hazard test: the jal skips two instructions that
# would overwrite ra. With a cold BTB fetch falls through and has both
# of them in the machine before the branch unit resolves the jump;
# recovery must squash them, or the program prints 222 instead of 5.
# Expected output: 5, exit 0.

00500093   # 0x00  addi ra, zero, 5     ; ra = 5
00C0006F   # 0x04  jal  zero, +12       ; goto 0x10
06F00093   # 0x08  addi ra, zero, 111   ; wrong path; must be squashed
0DE00093   # 0x0c  addi ra, zero, 222   ; wrong path; must be squashed
00008513   # 0x10  addi a0, ra, 0       ; a0 = 5
00100893   # 0x14  addi a7, zero, 1     ; syscall 1: print_int
00000073   # 0x18  ecall                ; prints "5"
00000513   # 0x1c  addi a0, zero, 0     ; exit code 0
05D00893   # 0x20  addi a7, zero, 93    ; syscall 93: exit
00000073   # 0x24  ecall
